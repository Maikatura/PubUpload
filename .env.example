# Copy to .env next to compose.yaml and fill in real values. .env is gitignored.
DB_CONNECTION_STRING=Host=your-db-host;Port=5432;Database=fileuploader;Username=fileuploader;Password=change-me
# Optional. Comma-separated sites allowed to call the API from a browser. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Optional branding. Leave out to use the defaults.
INSTANCE_NAME=PubUpload
INSTANCE_TAGLINE=Anonymous file hosting
INSTANCE_ICON=📤
INSTANCE_FOOTER_TEXT=anonymous file hosting
INSTANCE_RETENTION_DAYS=30
