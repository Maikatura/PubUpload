@inherits LayoutComponentBase
@using FileUploader.Models
@using Microsoft.Extensions.Options
@inject IOptions<InstanceOptions> Instance

<div class="page-wrapper">
    <header class="site-header">
        <a href="/" class="header-brand">
            <span class="brand-icon">@Instance.Value.Icon</span>
            <span class="brand-text">@Instance.Value.Name.ToLowerInvariant()</span>
        </a>
        <nav class="header-nav">
            <a href="/" class="nav-link">upload</a>
            <a href="/p/sharex" class="nav-link">sharex</a>
            <a href="/p/privacy" class="nav-link">privacy</a>
        </nav>
    </header>

    <main class="page-body">
        @Body
    </main>

    <footer class="site-footer">
        <span class="footer-text">@Instance.Value.FooterText</span>
    </footer>
</div>
